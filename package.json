{
  "name": "pill-clip-lab",
  "private": true,
  "version": "0.1.1",
  "type": "module",
  "description": "A character studio for procedural SVG avatars: build a body, layer the eyes, sequence animations, and export a lightweight embeddable clip.",
  "license": "MIT",
  "author": "Tonio",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/tonio-alucema/pill-clip-lab.git"
  },
  "keywords": [
    "svg",
    "animation",
    "avatar",
    "vue",
    "morphing",
    "character"
  ],
  "packageManager": "pnpm@11.17.0",
  "scripts": {
    "dev": "vite",
    "build": "vue-tsc --noEmit && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "mediabunny": "^1.54.0",
    "vue": "^3.5.41"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^26.0.0",
    "@vitejs/plugin-vue": "^6.0.8",
    "happy-dom": "^20.11.2",
    "tailwindcss": "^4.3.3",
    "typescript": "^5.9.3",
    "vite": "^8.2.1",
    "vitest": "^4.1.10",
    "vue-tsc": "^3.3.9"
  },
  "contributors": [
    "Jérémy Perret (bloub, https://github.com/jeremy-prt/bloub)"
  ]
}
